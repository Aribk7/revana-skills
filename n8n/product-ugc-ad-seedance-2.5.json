              "id": "5e6fc9a1-1672-58d4-910f-94bb64ae9f9a",
              "name": "audio",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "5ebcb552-172c-5af5-acb5-738471e6c395",
              "name": "max_cost_usd",
              "value": 3,
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "be5b1d07-e9f7-5ae9-86fa-c3e701b3d6ef",
      "name": "Get price list",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.revana.si/v1/models",
        "options": {}
      }
    },
    {
      "id": "17285df1-12f9-5cc2-8676-ffb465a083ee",
      "name": "Quote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "jsCode": "// Price the job from Revana's live price list (GET /v1/models, no key). Prices change: never hardcode them.\nconst s = $('Settings').first().json;\nconst m = $input.first().json.data.find((x) => x.id === s.model);\nif (!m) throw new Error(`Unknown model ${s.model}: see https://revana.si/pricing`);\nconst usd = m.price.usd;\nconst each = typeof usd === 'number' ? usd : (s.audio ? usd[`${s.resolution}+audio`] : undefined) ?? usd[s.resolution];\nif (each === undefined) throw new Error(`${s.model} has no ${s.resolution} price: ${JSON.stringify(usd)}`);\nconst seconds = m.price.unit === 'per_second' ? s.duration : 1;\n// Up to a whole cent; rounding first keeps float noise (0.07 x 3 = 0.21000000000000002) from adding a cent.\nconst quote_usd = Math.ceil(Math.round(each * seconds * 1e6) / 1e4 - 1e-9) / 100;\nconst cap_usd = quote_usd;\n// One Idempotency-Key for this run's video, made here once. A retry of \"Create generation\" sends the same key, so it\n// returns the video already started instead of making (and charging for) a second one. The execution id alone repeats\n// across n8n instances and reinstalls, and Revana keeps keys for the account, so a random part makes it unique.\nconst rand = Array.from({ length: 4 }, () => Math.random().toString(16).slice(2, 10).padEnd(8, '0')).join('');\nconst idempotency_key = `n8n-${$execution.id}-${Date.now().toString(36)}-${rand}`;\nreturn [{ json: { ...s, quote_usd, cap_usd, idempotency_key } }];"
      }
    },
    {
      "id": "38db7e19-906b-5927-8ffd-94872174ecdf",
      "name": "Within budget?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "d9c5be1e-4dbd-5124-adee-b8a8caca9737",
              "leftValue": "={{ $json.quote_usd }}",
              "rightValue": "={{ $json.max_cost_usd }}",
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
