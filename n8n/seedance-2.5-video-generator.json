              "value": "seedance-2.5",
              "type": "string"
            },
            {
              "id": "8eb20df8-4fdb-5d5c-94c8-cf6b96ca6a01",
              "name": "prompt",
              "value": "A paper boat drifting down a rainy city street at night, close up, neon reflections, gentle rain sounds",
              "type": "string"
            },
            {
              "id": "d2236128-4710-5fba-ac22-3b7b0fee6fd6",
              "name": "resolution",
              "value": "720p",
              "type": "string"
            },
