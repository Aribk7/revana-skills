              "value": true,
              "type": "boolean"
            },
            {
              "id": "a0ac4d9d-289e-5fc8-ade2-6b51ff743b57",
              "name": "image_url",
              "value": "",
              "type": "string"
            },
            {
              "id": "5ebcb552-172c-5af5-acb5-738471e6c395",
              "name": "max_cost_usd",
              "value": 2,
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "be5b1d07-e9f7-5ae9-86fa-c3e701b3d6ef",
      "name": "Get price list",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.revana.si/v1/models",
        "options": {}
      }
    },
    {
      "id": "17285df1-12f9-5cc2-8676-ffb465a083ee",
      "name": "Quote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "jsCode": "// Price the job from Revana's live price list (GET /v1/models, no key). Prices change: never hardcode them.\nconst s = $('Settings').first().json;\nconst m = $input.first().json.data.find((x) => x.id === s.model);\nif (!m) throw new Error(`Unknown model ${s.model}: see https://revana.si/pricing`);\nconst usd = m.price.usd;\nconst each = typeof usd === 'number' ? usd : (s.audio ? usd[`${s.resolution}+audio`] : undefined) ?? usd[s.resolution];\nif (each === undefined) throw new Error(`${s.model} has no ${s.resolution} price: ${JSON.stringify(usd)}`);\nconst seconds = m.price.unit === 'per_second' ? s.duration : 1;\nconst quote_usd = Math.ceil(each * seconds * 100) / 100;\nreturn [{ json: { ...s, quote_usd } }];"
      }
    },
    {
      "id": "38db7e19-906b-5927-8ffd-94872174ecdf",
      "name": "Within budget?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "d9c5be1e-4dbd-5124-adee-b8a8caca9737",
              "leftValue": "={{ $json.quote_usd }}",
              "rightValue": "={{ $json.max_cost_usd }}",
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "cde35ee4-db65-5273-b7d7-36c79d449ec0",
      "name": "Over budget",
      "type": "n8n-nodes-base.stopAndError",
