              "name": "Idempotency-Key",
              "value": "=n8n-{{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.model, input: { prompt: $json.prompt, resolution: $json.resolution, duration: $json.duration, aspect_ratio: $json.aspect_ratio, audio: $json.audio, ...($json.image_url ? { image_url: $json.image_url } : {}) }, max_cost_usd: $json.quote_usd }) }}",
        "options": {}
      }
    },
