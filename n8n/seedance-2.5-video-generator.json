      "position": [
        1100,
        300
      ],
      "parameters": {
        "errorMessage": "=This job costs ${{ $json.quote_usd }}, more than max_cost_usd ${{ $json.max_cost_usd }}. Raise max_cost_usd in Settings if that is OK."
      }
    },
    {
